<UserControl
    x:Class="Translumo.MVVM.Views.LlmSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel.Resources>
            <Style TargetType="{x:Type StackPanel}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
        </StackPanel.Resources>
        <StackPanel Orientation="Horizontal">
            <ComboBox
                Width="130"
                FontSize="14"
                ItemsSource="{Binding AvailableProviders}"
                SelectedItem="{Binding Model.Provider}"
                Style="{DynamicResource MaterialDesignComboBox}" />
            <Label
                Margin="10,0,0,0"
                Content="{DynamicResource Str.LlmSettings.Provider}"
                Style="{StaticResource ControlCaptionLabel}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <ComboBox
                Width="280"
                FontSize="14"
                IsEditable="True"
                ItemsSource="{Binding AvailableModels}"
                Style="{DynamicResource MaterialDesignComboBox}"
                Text="{Binding Model.Model, UpdateSourceTrigger=LostFocus}" />
            <Label
                Margin="10,0,0,0"
                Content="{DynamicResource Str.LlmSettings.Model}"
                Style="{StaticResource ControlCaptionLabel}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBox
                Width="280"
                FontSize="14"
                Style="{DynamicResource MaterialDesignTextBox}"
                Text="{Binding Model.ApiKey, UpdateSourceTrigger=LostFocus}" />
            <Label
                Margin="10,0,0,0"
                Content="{DynamicResource Str.LlmSettings.ApiKey}"
                Style="{StaticResource ControlCaptionLabel}" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <Label Content="{DynamicResource Str.LlmSettings.SystemPrompt}" Style="{StaticResource ControlCaptionLabel}" />
            <TextBox
                Width="475"
                Height="150"
                Margin="0,5,0,0"
                HorizontalAlignment="Left"
                AcceptsReturn="True"
                FontSize="13"
                Style="{DynamicResource MaterialDesignTextBox}"
                Text="{Binding Model.SystemPromptTemplate, UpdateSourceTrigger=LostFocus}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
            <Button
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                Command="{Binding RestoreDefaultPromptCommand}"
                Content="{DynamicResource Str.LlmSettings.RestoreDefault}"
                Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
